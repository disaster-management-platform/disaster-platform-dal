<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageId>DisasterPlatform.Security</PackageId>
    <Authors>disaster-management-platform</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/disaster-management-platform/disaster-platform-dal</RepositoryUrl>
    <Description>Shared ASP.NET Core authentication and disaster access policies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DisasterPlatform.Core/DisasterPlatform.Core.csproj" />
  </ItemGroup>
  <ItemGroup><None Include="../LICENSE" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
