<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>disaster-management-platform</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/disaster-management-platform/disaster-platform-dal</RepositoryUrl>
    <Description>SQLite persistence, repositories and migrations for disaster management services.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DisasterPlatform.Core/DisasterPlatform.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <Content Include="Migrations/Reconstruction/202611130001_InitialReconstruction.cs" Pack="true" PackagePath="contentFiles/any/any/Migrations/Reconstruction/" BuildAction="None" />
  </ItemGroup>
</Project>
